<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Editar tarea - TaskMaster</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <span class="brand">TaskMaster</span>
    <div class="user-area">
      <span>Hola, <%= username %></span>
      <a href="/logout" data-testid="logout-link">Cerrar sesión</a>
    </div>
  </header>

  <main class="container" style="grid-template-columns: 1fr; max-width: 480px;">
    <section class="form-section sheet">
      <span class="section-eyebrow">Editar nota</span>
      <h2>Editar tarea</h2>

      <% if (errors && errors.length > 0) { %>
        <ul class="error-message" data-testid="form-errors">
          <% errors.forEach(function(err) { %>
            <li><%= err.msg %></li>
          <% }); %>
        </ul>
      <% } %>

      <form method="POST" action="/tasks/<%= task.id %>" data-testid="edit-task-form">
        <label for="title">Título (máx. 50 caracteres)</label>
        <input type="text" id="title" name="title" maxlength="200" data-testid="task-title-input"
               value="<%= task.title %>">

        <label for="description">Descripción</label>
        <textarea id="description" name="description" data-testid="task-description-input"><%= task.description %></textarea>

        <label for="dueDate">Fecha límite</label>
        <input type="date" id="dueDate" name="dueDate" data-testid="task-duedate-input"
               value="<%= task.dueDate %>">

        <button type="submit" data-testid="update-task-button">Guardar cambios</button>
      </form>

      <a href="/tasks" class="back-link" data-testid="back-to-tasks-link">&larr; Volver a mis tareas</a>
    </section>
  </main>
</body>
</html>
