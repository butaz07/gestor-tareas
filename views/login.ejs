<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Iniciar sesión - TaskMaster</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-container">
      <div class="sheet">
        <span class="brand">TaskMaster</span>
        <h2>Iniciar sesión para ver tu bloc de tareas</h2>
        <hr class="rule-divider">

        <% if (error) { %>
          <p class="error-message" data-testid="login-error"><%= error %></p>
        <% } %>

        <form method="POST" action="/login" data-testid="login-form">
          <label for="username">Usuario</label>
          <input type="text" id="username" name="username" data-testid="username-input" required>

          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" data-testid="password-input" required>

          <button type="submit" data-testid="login-button">Ingresar</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
