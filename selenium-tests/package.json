{
  "name": "gestor-tareas-selenium-tests",
  "version": "1.0.0",
  "description": "Pruebas automatizadas con Selenium para Gestor de Tareas (Tarea 4)",
  "scripts": {
    "pretest": "node scripts/reset-db.js",
    "start-app": "node ../app.js",
    "test:mocha": "mocha test/**/*.test.js --timeout 20000 --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=report,overwrite=true,charts=true",
    "test": "start-server-and-test start-app http://localhost:3000/login test:mocha"
  },
  "dependencies": {
    "chai": "^4.4.1",
    "mocha": "^10.7.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.23.0",
    "start-server-and-test": "^2.0.4"
  }
}
